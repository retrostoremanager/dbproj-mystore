<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <SccProjectName>SAK</SccProjectName>
  <SccLocalPath>SAK</SccLocalPath>
  <SccAuxPath>SAK</SccAuxPath>
  <SccProvider>SAK</SccProvider>
  <ItemGroup>
    <Folder Include="Tables" />
    <Folder Include="Schemas" />
    <Folder Include="StoredProcedures" />
  </ItemGroup>
  <ItemGroup>
    <Build Include="Tables\Company.sql" />
    <Build Include="Tables\Customer.sql" />
    <Build Include="Tables\Employee.sql" />
    <Build Include="Tables\GameEncyclopedia.sql" />
    <Build Include="Tables\GameInventory.sql" />
    <Build Include="Tables\Sale.sql" />
    <Build Include="Tables\SaleItem.sql" />
  </ItemGroup>
  <ItemGroup>
    <Build Include="StoredProcedures\spCompany_GetById.sql" />
    <Build Include="StoredProcedures\spCompany_GetByEmail.sql" />
    <Build Include="StoredProcedures\spCompany_GetByVerificationToken.sql" />
    <Build Include="StoredProcedures\spCompany_Create.sql" />
    <Build Include="StoredProcedures\spCompany_Update.sql" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Schemas\dbo.sql" />
  </ItemGroup>
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">11.0</VisualStudioVersion>
    <DefaultTargetFramework>net462</DefaultTargetFramework>
    <MinimumVisualStudioVersion>$(VisualStudioVersion)</MinimumVisualStudioVersion>
    <SqlServerVersion>Sql150</SqlServerVersion>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql150DatabaseSchemaProvider</DSP>
    <ModelCollation>SQL_Latin1_General_CP1_CI_AS</ModelCollation>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="'$(ImportCommonProps)' == 'true'" />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\SSDT\Microsoft.Data.Tools.Schema.SqlTasks.targets" Condition="'$(VisualStudioVersion)' != '' and '$(SQLDBExtensionsRefPath)' == ''" />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\SSDT\Microsoft.Data.Tools.Schema.SqlTasks.targets" Condition="'$(VisualStudioVersion)' != '' and '$(SQLDBExtensionsRefPath)' != ''" />
  <PropertyGroup Condition="'$(SQLDBExtensionsRefPath)' != ''">
    <AssemblyName>MyStore.Database</AssemblyName>
    <FullPath>$(MSBuildProjectFile)</FullPath>
  </PropertyGroup>
</Project>

